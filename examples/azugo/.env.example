# Every setting the playground reads. Each one is optional: the value
# shown after "=" is the default, and a commented line has no default.
# Lists use ";" as the separator. Durations use Go syntax (30s, 1m).

# --- Application -------------------------------------------------------
# development, test, staging or production (anything else: production).
ENVIRONMENT=development
APP_NAME=playground
# Defaults to the module version stamped into the binary, or "dev".
# APP_VERSION=dev

# --- PostgreSQL --------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Read the password from a file instead (POSTGRES_PASSWORD wins if set).
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_DB=postgres
# disable, allow, prefer, require, verify-ca or verify-full.
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://postgres:@localhost:5432/postgres?sslmode=disable

# --- Server ------------------------------------------------------------
# The first http:// URL sets the HTTP address, port and base path; the
# first https:// URL enables HTTPS. Unset: http://0.0.0.0:8080/.
SERVER_URLS=http://localhost:3000/
# Overrides the path from SERVER_URLS.
# BASE_PATH=/
# SERVER_HTTPS_CERTIFICATE_PEM_FILE=
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=75s
# Bytes (4 MiB).
SERVER_MAX_REQUEST_BODY_SIZE=4194304
SERVER_SHUTDOWN_TIMEOUT=30s
# Logs every request unless set to anything other than "true".
ACCESS_LOG_ENABLED=true

# --- CORS --------------------------------------------------------------
# Allowed origins, for example https://a.example;https://b.example.
# CORS_ORIGINS=

# --- Reverse proxy -----------------------------------------------------
REVERSE_PROXY_TRUSTED_IPS=127.0.0.1
REVERSE_PROXY_TRUSTED_HEADERS=X-Real-IP;X-Forwarded-For
REVERSE_PROXY_LIMIT=1

# --- Metrics and health ------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_TRUSTED_IPS=127.0.0.1
HEALTHZ_ENABLED=true
HEALTHZ_TRUSTED_IPS=127.0.0.1

# --- Paging ------------------------------------------------------------
PAGING_DEFAULT_PAGE_SIZE=20
PAGING_MAX_PAGE_SIZE=100

# --- Rate limiting -----------------------------------------------------
RATELIMIT_ENABLED=false
# fixed-window (uses LIMIT per WINDOW) or token-bucket (uses RATE per
# second and BURST).
RATELIMIT_STRATEGY=fixed-window
RATELIMIT_LIMIT=60
RATELIMIT_WINDOW=1m
RATELIMIT_RATE=1
RATELIMIT_BURST=60
# How long a limited request may wait for a slot.
# RATELIMIT_WAIT_LIMIT=

# --- Flash messages ----------------------------------------------------
FLASH_COOKIE_NAME=flash
# How long an unread flash message is kept.
FLASH_TTL=0s

# --- Cache -------------------------------------------------------------
# memory, redis, redis-cluster or redis-sentinel.
CACHE_TYPE=memory
# CACHE_CONNECTION=redis://localhost:6379/0
# CACHE_PASSWORD=
# CACHE_PASSWORD_FILE=/run/secrets/cache_password
# CACHE_TTL=
# CACHE_KEY_PREFIX=
CACHE_CLIENT_CACHE=true
# CACHE_CLIENT_CACHE_TTL=
# Bytes (16 MiB).
CACHE_CLIENT_CACHE_SIZE=16777216

# --- Logging -----------------------------------------------------------
# console, file or another registered target.
LOG_TYPE=console
# debug, info, warn, error, dpanic, panic or fatal. Unset: debug in
# development, info elsewhere.
# LOG_LEVEL=
# console, json or ecsjson. Unset: console in development, ecsjson elsewhere.
# LOG_FORMAT=
LOG_OUTPUT=stderr
LOG_STACKTRACE=false
# A second log output, with the same values as above.
# LOG_TYPE_SECONDARY=
# LOG_LEVEL_SECONDARY=
# LOG_FORMAT_SECONDARY=
# LOG_OUTPUT_SECONDARY=

# --- Playground --------------------------------------------------------
TEST=Default value
